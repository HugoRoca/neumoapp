DATABASE_URL=postgresql://root:root@localhost:5432/neumoapp_db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Asistente IA (POST /chat) ---
# Elige UNA: OpenAI (nube) u Ollama (local). No actives las dos a la vez.

# Opción A — OpenAI (recomendado en producción)
# Crea la clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-reemplazar
OPENAI_CHAT_MODEL=gpt-4o-mini
# No pongas OPENAI_BASE_URL (así se usa api.openai.com)

# Opción B — Ollama local (comenta OPENAI_API_KEY de arriba o déjala vacía; descomenta las 2 líneas siguientes)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_CHAT_MODEL=llama3.2
#
# --- Latencia del asistente (POST /chat) ---
# - Cada "ronda" con el modelo (sobre todo si pide herramientas una tras otra) suma segundos.
# - OpenAI en la nube con gpt-4o-mini suele ser el más rápido para producción.
# - Ollama en CPU o modelos grandes puede tardar mucho (varios segundos o más por mensaje); GPU y modelos
#   más pequeños (p. ej. llama3.2:3b) mejoran mucho.
# - El flujo guiado de agendamiento (wizard) no usa el LLM y suele responder al instante.

# Zona horaria para reglas de "hoy" / horarios ya pasados (IANA)
APP_TIMEZONE=America/Lima
